<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>HdlcGatewayTest.App.Tests</AssemblyName>
    <RootNamespace>HdlcGatewayTest.App.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- View-model tests, plus the screenshot test (Screenshots.cs), which draws the real window
         off screen with Avalonia.Headless 12.1.3. Avalonia.Headless.NUnit has no 12.x release in
         reach, so that test starts its own headless session instead. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\HdlcGatewayTest.Core.Tests\FakeTransport.cs" Link="Fakes\FakeTransport.cs" />
    <Compile Include="..\HdlcGatewayTest.Core.Tests\FakeGateway.cs" Link="Fakes\FakeGateway.cs" />
    <Compile Include="..\HdlcGatewayTest.Mcp.Tests\HdlcToolProviderTests.cs" Link="Fakes\FakeTransportFactory.cs"
             Condition="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\HdlcGatewayTest.Core\HdlcGatewayTest.Core.csproj" />
    <ProjectReference Include="..\..\HdlcGatewayTest.Gateway\HdlcGatewayTest.Gateway.csproj" />
    <ProjectReference Include="..\..\HdlcGatewayTest.App\HdlcGatewayTest.App.csproj" />
  </ItemGroup>

</Project>

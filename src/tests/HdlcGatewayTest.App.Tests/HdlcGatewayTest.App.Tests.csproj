  <PropertyGroup>
    <AssemblyName>HdlcGatewayTest.App.Tests</AssemblyName>
    <RootNamespace>HdlcGatewayTest.App.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

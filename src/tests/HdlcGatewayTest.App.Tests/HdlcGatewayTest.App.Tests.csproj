  <ItemGroup>
    <Compile Include="..\HdlcGatewayTest.Core.Tests\FakeTransport.cs" Link="Fakes\FakeTransport.cs" />
    <Compile Include="..\HdlcGatewayTest.Core.Tests\FakeGateway.cs" Link="Fakes\FakeGateway.cs" />
    <Compile Include="..\HdlcGatewayTest.Mcp.Tests\HdlcToolProviderTests.cs" Link="Fakes\FakeTransportFactory.cs"
             Condition="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\HdlcGatewayTest.Core\HdlcGatewayTest.Core.csproj" />
    <ProjectReference Include="..\..\HdlcGatewayTest.Gateway\HdlcGatewayTest.Gateway.csproj" />
    <ProjectReference Include="..\..\HdlcGatewayTest.App\HdlcGatewayTest.App.csproj" />
  </ItemGroup>


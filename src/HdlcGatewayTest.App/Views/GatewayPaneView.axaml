<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HdlcGatewayTest.App.ViewModels"
             x:Class="HdlcGatewayTest.App.Views.GatewayPaneView"
             x:DataType="vm:GatewayPaneViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,3,*,Auto" Margin="6">

        <!-- Header: setup, connect, state. Everything that configures the pane lives in the Setup
             window (Ronny, 2026-11-09), so the pane itself stays readable. -->
        <DockPanel Grid.Row="0" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button DockPanel.Dock="Left" Content="Setup..." Command="{Binding SetupCommand}"
                    ToolTip.Tip="Serial port or TCP client, line speed, role, TCP server, firmware log: all in one window." />
            <Button DockPanel.Dock="Left" Content="Connect" Command="{Binding ConnectCommand}" Margin="6,0,0,0" />
            <Button DockPanel.Dock="Left" Content="Disconnect" Command="{Binding DisconnectCommand}" Margin="4,0,0,0" />
            <TextBlock Classes="badge" Text="{Binding StateText}" VerticalAlignment="Center" Margin="10,0,0,0" />
            <TextBlock Text="{Binding IdentityText}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="SlateGray" />
        </DockPanel>

        <!-- One line: how the pane is set up right now. -->
        <TextBlock Grid.Row="1" Text="{Binding ConfigSummary}" Margin="0,4,0,0" FontSize="12" Opacity="0.85" TextWrapping="Wrap" />

        <!-- Console. -->
        <ListBox Grid.Row="2" x:Name="ConsoleList" Classes="mono" FontSize="12" Margin="0,6,0,0"
                 ItemsSource="{Binding ConsoleLines}" SelectionMode="Single">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ConsoleLineViewModel">
                    <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="4,0" />
                    <Setter Property="MinHeight" Value="18" />
                </Style>
            </ListBox.Styles>
        </ListBox>

        <!-- Command entry. -->
        <DockPanel Grid.Row="3" LastChildFill="True" Margin="0,4,0,0">
            <Button DockPanel.Dock="Right" Content="Send" Command="{Binding SendCommand}" Margin="4,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearConsoleCommand}" Margin="4,0,0,0" />
            <CheckBox DockPanel.Dock="Right" Content="follow" IsChecked="{Binding AutoScroll}" Margin="8,0,0,0" />
            <TextBox x:Name="CommandBox" Classes="mono" Text="{Binding CommandText}"
                     PlaceholderText="firmware command: HELP, STAT, BAUD 38400, F, INSPECT ... (Enter sends, Up/Down history)" />
        </DockPanel>

        <!-- Hex entry, Free role only. -->
        <DockPanel Grid.Row="4" LastChildFill="True" Margin="0,4,0,0" IsVisible="{Binding ShowHexBox}">
            <Button DockPanel.Dock="Right" Content="Send frame" Command="{Binding SendHexCommand}" Margin="4,0,0,0" />
            <CheckBox DockPanel.Dock="Right" Content="add FCS" IsChecked="{Binding AddFcs}" Margin="8,0,0,0" />
            <TextBox Classes="mono" Text="{Binding HexText}" AcceptsReturn="True" MaxHeight="80"
                     PlaceholderText="hex bytes to send as one frame: 01 3F  or  0103484900 (spaces, commas, 0x allowed)" />
        </DockPanel>

        <!-- Frame list header. -->
        <DockPanel Grid.Row="5" LastChildFill="True" Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearFramesCommand}" />
            <TextBox DockPanel.Dock="Right" Width="220" Margin="0,0,6,0" Text="{Binding FrameFilter}"
                     PlaceholderText="filter: RX, TX, addr 01, SABM, FCS BAD, Tcp ..." />
            <TextBlock Text="Frames (click one to decode it)" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <GridSplitter Grid.Row="6" Background="Gray" ResizeDirection="Rows" />

        <!-- Frame list and detail. -->
        <Grid Grid.Row="7" ColumnDefinitions="*,3,320">
            <ListBox Grid.Column="0" Classes="mono" FontSize="11" ItemsSource="{Binding Frames}"
                     SelectedItem="{Binding SelectedFrame}" SelectionMode="Single">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FrameRecordViewModel">
                        <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="4,0" />
                        <Setter Property="MinHeight" Value="18" />
                    </Style>
                </ListBox.Styles>
            </ListBox>
            <GridSplitter Grid.Column="1" Background="Gray" ResizeDirection="Columns" />
            <ScrollViewer Grid.Column="2">
                <TextBox Classes="mono" FontSize="11" Text="{Binding FrameDetail}" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="NoWrap" BorderThickness="0" />
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="8" Text="" />
    </Grid>
</UserControl>

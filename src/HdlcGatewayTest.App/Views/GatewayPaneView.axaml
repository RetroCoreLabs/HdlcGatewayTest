<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HdlcGatewayTest.App.ViewModels"
             x:Class="HdlcGatewayTest.App.Views.GatewayPaneView"
             x:DataType="vm:GatewayPaneViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,3,*,Auto" Margin="6">

        <!-- Header: port, connect, state. -->
        <DockPanel Grid.Row="0" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox DockPanel.Dock="Left" Width="110" ItemsSource="{Binding Endpoints}"
                      SelectedItem="{Binding SelectedEndpoint}" />
            <Button DockPanel.Dock="Left" Content="&#x21bb;" ToolTip.Tip="Refresh the port list"
                    Command="{Binding RefreshPortsCommand}" Margin="2,0" />
            <Button DockPanel.Dock="Left" Content="Connect" Command="{Binding ConnectCommand}" Margin="6,0,0,0" />
            <Button DockPanel.Dock="Left" Content="Disconnect" Command="{Binding DisconnectCommand}" Margin="4,0,0,0" />
            <CheckBox DockPanel.Dock="Left" Content="legacy console" IsChecked="{Binding UseTextConsole}" Margin="8,0,0,0"
                      ToolTip.Tip="Tick for a gateway without command frames (RC422Dev): the probe then also tries ESC ESC ESC. Off: HELLO frames only, no ESC byte ever." />
            <TextBlock Classes="badge" Text="{Binding StateText}" VerticalAlignment="Center" Margin="10,0,0,0" />
        </DockPanel>

        <!-- Identity, role, baud, log level. -->
        <DockPanel Grid.Row="1" LastChildFill="True" Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Left" Text="Role" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox DockPanel.Dock="Left" Width="110" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}"
                      ToolTip.Tip="Console: commands and listing. Free: paste hex. Echo: send back what is received. Bridge: A to B and B to A. TcpListen: nd100x over TCP." />
            <TextBlock DockPanel.Dock="Left" Text="Line BAUD" VerticalAlignment="Center" Margin="12,0,4,0" />
            <AutoCompleteBox DockPanel.Dock="Left" Width="100" ItemsSource="{Binding BaudRates}" Text="{Binding SelectedBaud}"
                             MinimumPrefixLength="0" />
            <Button DockPanel.Dock="Left" Content="Set" Command="{Binding SetBaudCommand}" Margin="2,0,0,0"
                    ToolTip.Tip="Send BAUD to the gateway: its transmit clock" />
            <TextBlock DockPanel.Dock="Left" Text="Firmware log" VerticalAlignment="Center" Margin="12,0,4,0" />
            <ComboBox DockPanel.Dock="Left" Width="90" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding SelectedLogLevel}"
                      IsEnabled="{Binding HasFirmwareLog}"
                      ToolTip.Tip="Firmware log lines arrive as frames while traffic flows. Needs a control-frame firmware." />
            <TextBlock Text="{Binding IdentityText}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="SlateGray" />
        </DockPanel>

        <!-- TCP listen row, only in that role. -->
        <DockPanel Grid.Row="2" LastChildFill="True" Margin="0,4,0,0" IsVisible="{Binding ShowTcpBox}">
            <TextBlock DockPanel.Dock="Left" Text="TCP port" VerticalAlignment="Center" Margin="0,0,4,0" />
            <NumericUpDown DockPanel.Dock="Left" Value="{Binding TcpPort}" Minimum="1" Maximum="65535" Increment="1"
                           FormatString="0" Width="120" ShowButtonSpinner="False" />
            <Button DockPanel.Dock="Left" Content="Stop listening" Command="{Binding StopTcpCommand}" Margin="6,0,0,0" />
            <TextBlock Text="{Binding TcpText}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="SlateGray" />
        </DockPanel>

        <!-- Console. -->
        <ListBox Grid.Row="3" x:Name="ConsoleList" Classes="mono" FontSize="12" Margin="0,6,0,0"
                 ItemsSource="{Binding ConsoleLines}" SelectionMode="Single">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ConsoleLineViewModel">
                    <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="4,0" />
                    <Setter Property="MinHeight" Value="18" />
                </Style>
            </ListBox.Styles>
        </ListBox>

        <!-- Command entry. -->
        <DockPanel Grid.Row="4" LastChildFill="True" Margin="0,4,0,0">
            <Button DockPanel.Dock="Right" Content="Send" Command="{Binding SendCommand}" Margin="4,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearConsoleCommand}" Margin="4,0,0,0" />
            <CheckBox DockPanel.Dock="Right" Content="follow" IsChecked="{Binding AutoScroll}" Margin="8,0,0,0" />
            <TextBox x:Name="CommandBox" Classes="mono" Text="{Binding CommandText}"
                     PlaceholderText="firmware command: HELP, STAT, BAUD 38400, F, INSPECT ... (Enter sends, Up/Down history)" />
        </DockPanel>

        <!-- Hex entry, Free role only. -->
        <DockPanel Grid.Row="5" LastChildFill="True" Margin="0,4,0,0" IsVisible="{Binding ShowHexBox}">
            <Button DockPanel.Dock="Right" Content="Send frame" Command="{Binding SendHexCommand}" Margin="4,0,0,0" />
            <CheckBox DockPanel.Dock="Right" Content="add FCS" IsChecked="{Binding AddFcs}" Margin="8,0,0,0" />
            <TextBox Classes="mono" Text="{Binding HexText}" AcceptsReturn="True" MaxHeight="80"
                     PlaceholderText="hex bytes to send as one frame: 01 3F  or  0103484900 (spaces, commas, 0x allowed)" />
        </DockPanel>

        <!-- Frame list header. -->
        <DockPanel Grid.Row="6" LastChildFill="True" Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearFramesCommand}" />
            <TextBox DockPanel.Dock="Right" Width="220" Margin="0,0,6,0" Text="{Binding FrameFilter}"
                     PlaceholderText="filter: RX, TX, addr 01, SABM, FCS BAD, Tcp ..." />
            <TextBlock Text="Frames (click one to decode it)" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <GridSplitter Grid.Row="7" Background="Gray" ResizeDirection="Rows" />

        <!-- Frame list and detail. -->
        <Grid Grid.Row="8" ColumnDefinitions="*,3,320">
            <ListBox Grid.Column="0" Classes="mono" FontSize="11" ItemsSource="{Binding Frames}"
                     SelectedItem="{Binding SelectedFrame}" SelectionMode="Single">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FrameRecordViewModel">
                        <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="4,0" />
                        <Setter Property="MinHeight" Value="18" />
                    </Style>
                </ListBox.Styles>
            </ListBox>
            <GridSplitter Grid.Column="1" Background="Gray" ResizeDirection="Columns" />
            <ScrollViewer Grid.Column="2">
                <TextBox Classes="mono" FontSize="11" Text="{Binding FrameDetail}" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="NoWrap" BorderThickness="0" />
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="9" Text="" />
    </Grid>
</UserControl>

<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HdlcGatewayTest.App.App"
             RequestedThemeVariant="Default">
    <!-- Default follows the system light/dark setting. -->
    <Application.Styles>
        <FluentTheme />
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New, monospace" />
        </Style>
        <Style Selector="TextBox.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New, monospace" />
        </Style>
        <Style Selector="ListBox.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New, monospace" />
        </Style>
        <Style Selector="TextBlock.badge">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
    </Application.Styles>
</Application>
